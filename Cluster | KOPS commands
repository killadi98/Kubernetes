# we don't need to install docker like minikube.
# just install kops from official website.

curl -Lo kops https://github.com/kubernetes/kops/releases/download/$(curl -s https://api.github.com/repos/kubernetes/kops/releases/latest | grep tag_name | cut -d '"' -f 4)/kops-linux-amd64
chmod +x kops
sudo mv kops /usr/local/bin/kops

| kops version | gives the version of kops installed | to check if kops is installed |

# install kubectl like we did for minikube

curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"

| kubectl version |

| chmod +x kubectl |

| mv kubectl /usr/local/bin/ |

# I already have a bucket

# If not create an s3 bucket | bucket name should be unique though and enable bucket versioning

Give permission to this instance using IAM (Identity Access Management)

| aws s3 ls | list of buckets |

| export KOPS_STATE_STORE=s3://kopsbucket98 | stores cluster data in the bucket named kopsbucket98

# creating cluster with one worker node in one availability zone and one in another availability zone

kops create cluster --name clustername.k8s.local --zones us-east-1a,us-east-1b --master-count 1 --master-size c7i-flex.large --master-volume-size 30 --node-count 2 --node-size t3.micro --node-volume-size 20 --image=ami-0d97d7f07b25dd693

#after creating the cluster, run
kops update cluster --name clustername.k8s.local --yes --admin

| kops get cluster | gives the list of cluster |

| kops delete cluster cluster_name --yes | deletes the cluster |

| kubectl get nodes | gives the list of nodes like control plane and worker nodes | also works with kubectl get no |

| kubectl run pod-1 --image=nginx | creates a pod based on nginx image | imperative method

