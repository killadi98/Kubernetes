# Manifest file for storage-class:

---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: mysql-gp3
  annotations:
    storageclass.kubernetes.io/is-default-class: "false"
provisioner: ebs.csi.aws.com
parameters:
  type: gp3
  fsType: ext4
  encrypted: "true"
  iops: "3000"
  throughput: "125"
reclaimPolicy: Retain
allowVolumeExpansion: true
volumeBindingMode: WaitForFirstConsumer

# Manifest file for persistent volume claim:

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: mysql-data
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: mysql-gp3
  resources:
    requests:
      storage: 10Gi

# Deployment file with volumen mounting.

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: flm
spec:
  replicas: 2
  selector:
    matchLabels:
      app: swiggy
  template:
    metadata:
      labels:
        app: swiggy

    spec:
      containers:
        - name: cont1
          image: shaikmustafa/paytm:bus
          ports:
            - containerPort: 80
          volumeMounts:
            - name: mydata
              mountPath: /var/lib/mysql/

      volumes:
        - name: mydata
          persistentVolumeClaim:
            claimName: mysql-data











