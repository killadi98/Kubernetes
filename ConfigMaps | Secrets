# We can send all the configuration information like the ports, APIs other configurations by cretaing config maps and attaching them to the containers. ConfigMaps is a k8s object which can store non sensitive data. Secrets are used to store sensitive data like userIDs and passwords and inject them into the pods. 

# The maximum amount of data can be stored is 1MB. If we want to store more than 1 MB we use volumes.

| kubectl create cm cm-name --from-literal=PORT=3000 --from-literal=env=dev --from-literal=DB_HOST=mysqldb | to create the cm |

| kubectl get cm |
| kubectl describe cm cm-name |

# By using .env file

# create app.env

| kubectl create cm cm-name --from-env-file=app.env|

| kubectl get cm cm-name -o yaml |

# Declarative way by creating a manifest file

# manifest file for config map
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cm-name3
data:
  student: divya
  place: hyd
  company: tcs

# attaching the cm to the pods

# Deployment manifest file
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: deploy-name
spec:
  replicas: 3
  selector:
    matchLabels:
      app: swiggy
  template:
    metadata:
      labels:
        app: swiggy
    spec:
      containers:
        - name: cont1
          image: nginx
          ports:
            - containerPort: 80
          envFrom:
            - configMapRef:
                name: cm-name3













